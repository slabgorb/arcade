	.TITLE CONWAY
; MARK CERNY	JULY, 1982
; LIFE ALGORITHMS FOR MILLIPEDE
	.RADIX 16
	.ENABL AMA
	.NLIST
	.INCLUDE HLL65F
	.INCLUDE MLDEF
	.LIST
	.CSECT CONWAY
INICON:	LDX #00
	STX PHASE
	STX CTEMP1
	INX
	STX CDONE
	LDX #10
	STX CTEMP1+1		;SET UP FOR INDIRECT ACCESSING
	DEX
	STX CTEMP2+1
	LDX #0BE
	STX CTEMP2
	RTS
	.PAGE
	.SBTTL	MASTER CONTROL PROGRAM
MASTER:	LDX #01
10$:	LDA CTEMP1(X)		;RESTORE INDIRECT REGISTERS FROM PAGE 3
	STA OBST(X)
	LDA CTEMP2(X)
	STA TEMP2(X)
	DEX
	BPL 10$
20$:	LDA OBST		;OBST IS OUR POSITION ON THE SCREEN
	AND #1F
	CMP #1E
	BCS 100$		;REMOVE TOP TWO ROWS
	CMP #01
	BCC 100$		;REMOVE BOTTOM TWO ROWS
	LDX #00
	BIT CKIND
	IFMI
	CMP #19
	IFCS
	LDX #80
	ENDIF
	ELSE
	CMP #07
	IFCC
	LDX #80
	ENDIF
	ENDIF
	STX MSKORA
	LDA PHASE
	IFEQ
	JSR STARTGR		;PHASE=0, START PROCESS
	ELSE
	CMP #MAXPH
	IFEQ
	JSR CLEANUP		;END PROCESS
	ELSE
	JSR GROWDIE		;CONTINUE PROCESS
	ENDIF
	ENDIF
100$:	INC OBST
	IFEQ
	INC OBST+1
	ENDIF
	INC TEMP2
	IFEQ
	INC TEMP2+1
	ENDIF
	LDA OBST
	LDY PHASE
	IFEQ
	AND #0F			;WE DO 1/2 COLUMN AT A TIME
	ELSE
	AND #1F
	ENDIF
	BNE 20$			;CONTINUE EXECUTING UNTIL FINISHED
	LDA OBST
	CMP #0C0
	IFEQ
	LDA OBST+1
	CMP #PLYFLD/100+3
	IFEQ
	LDA PHASE		;WE HAVE FINISHED THE SCREEN
	IFNE
	LDA NGROWN
	IFEQ
	LDA #MAXPH		;ONE WAY TO END
	STA PHASE		;MUSHROOMS ALL GROWN
	ENDIF
	ENDIF
	INC PHASE
	LDA #00
	STA NGROWN
	STA OBST
	LDA #10
	STA OBST+1
	LDA PHASE
	CMP #MAXPH+1
	IFEQ
	LDA #00
	STA CDONE		;TIMER RAN OUT, END CONWAY
	ENDIF
	ENDIF
	ENDIF
	LDX #01
110$:	LDA OBST(X)		;SAME DIRECT REGISTORS TO PAGE 3
	STA CTEMP1(X)
	LDA TEMP2(X)
	STA CTEMP2(X)
	DEX
	BPL 110$
	RTS
	.PAGE
	.SBTTL	END CONWAY IF PLAYER IS PROLONGING IT
CLEANUP:LDY #00			;WE REPLACE GROWTH STAGES WITH
	LDA NY,OBST		;SHOT AWAY STAGES
	AND #7F
	CMP #GROWTH
	BCC 10$
	CMP #POISON
	BCS 10$			;SELECT ONLY GROWTH STAGES
	CLC
	ADC #NORMAL-GROWTH
	ORA MSKORA
	STA NY,OBST
10$:	RTS
	.PAGE
	.SBTTL	GROW AND KILL PARTIAL STAGES
GROWDIE:LDY #00
	LDA NY,OBST
	AND #7F
	CMP #DEATHS
	BCC 50$
	CMP #POISON
	BCS 50$			;SELECT ONLY GROWTH AND DEATH STAGES
	CMP #GROWTH
	BCC 30$			;NOW ONLY GROWTH STAGES
	CMP #POISON-1
	IFEQ
	LDA #NORMAL+3		;IF GROWN ALL THE WAY
	ELSE NE
	CLC
	ADC #01
	STA NGROWN
	ENDIF			;IF STILL GROWING
	ORA MSKORA
	STA NY,OBST
	JMP 50$
30$:	CMP #DEATHS		;NOW THE DEATH STAGES
	IFEQ
	JSR MUSHDC		;DECREMENT MUSHROOM COUNT
	LDA #00			;DIED TOTALLY
	ELSE EQ
	SEC
	SBC #01			;STILL DYING
	STA NGROWN
	ENDIF
	ORA MSKORA
	STA NY,OBST
50$:	RTS
	.PAGE
	.SBTTL	START BY CHANGING PICTURES TO SET UP GROWTH, DEATH
STARTGR:LDA OBST
	AND #1F
	CMP #20-2
	BCS 5$			;LEAVE TOP ROW AND SCORES ALONE
	CMP #2
	BCS 7$			;LEAVE BOTTOM ROW AND MESSAGE LINE ALONE
5$:	RTS
7$:	LDA #0A0
	STA COLMAX		;THIS IS THE NUMBER OF COLUMNS X 20
	LDA #00			;SPANNED BY THE ALGORITHIM
	STA MSHTTL
	LDX #00
	LDY #00
	LDA OBST+1
	CMP #10			;CHECK IF WE ARE ON A SCREEN EDGE
	IFEQ
	LDA OBST
	CMP #20			;OFF RIGHT EDGE OF SCREEN
	IFCC
	LDX #0A
	LDY #40			;START ALGORITHM LATER TO REFLECT THIS
	LDA #EDGE
	STA MSHTTL		;1 MUSHROOM ASSUMED OFF-SCREEN
	ELSE PL
	CMP #40
	IFCC
	LDX #05
	LDY #20
	ENDIF
	ENDIF
	ENDIF
	LDA OBST+1
	CMP #13			;OFF LEFT EDGE OF SCREEN
	IFEQ
	LDA OBST
	CMP #80
	IFCS
	CMP #0A0
	IFCS
	LDA #60
	STA COLMAX
	LDA #EDGE
	STA MSHTTL
	ELSE PL
	LDA #80
	STA COLMAX
	ENDIF
	ENDIF
	ENDIF
10$:	LDA GRCODE(X)		;TYPE OF SQUARE
	IFEQ			;CODE=0
	LDA NY,TEMP2		;STRAIGHT CONWAY, KILL IF POISON MUSHROOM
	AND #7F
	CMP #DDT
	BEQ 11$
	CMP #DDT+1
	BNE 12$
11$:	LDA MSHTTL
	ORA #80
	STA MSHTTL
	JMP 20$
12$:	CMP #POISON
	BCC 15$
	CMP #NORMAL
	BCS 15$
	LDA #20
	ORA MSHTTL
	STA MSHTTL
	JMP 20$
15$:	CMP #DEATHS
	BCC 20$
	CMP #GROWTH
	BEQ 20$
	INC MSHTTL
	JMP 20$
	ENDIF
	CMP #01			;CODE=1
	IFEQ
	LDA NY,TEMP2		;IF POISON MUSHROOM, GROW
	AND #7F
	CMP #POISON
	BCC 20$
	CMP #NORMAL
	BCS 20$
	LDA #10
	ORA MSHTTL
	STA MSHTTL		;GO TO GROWTH SETUP
	ENDIF			;CODE=2, DO NOTHING
20$:	INX
	INY
	TYA
	AND #1F
	CMP #05
	BNE 10$			;END OF ROW CODE
	TYA
	CLC
	ADC #1B
	TAY
	CPY COLMAX
	BNE 10$			;END OF TEMPLATE?
30$:	LDY #00
	LDA NY,OBST		;FIND OUT WHAT THE MUSHROOM
	AND #7F
	TAX			;WE ARE AT IS
	IFEQ
	LDA MSHTTL		;BLANK SPOT
	AND #7F
	CMP #20
	BCS 60$
	CMP #03			;GROW ON 3 OR 10
	BEQ 40$
	CMP #10
	BCS 40$
	BNE 60$			;BRA
40$:	LDY #GROWTH
	JSR MUSHE1		;CHANGE MUSHROOM COUNT
	JMP 70$
	ENDIF			;BRA
;	LDA NY,TEMP2
	CMP #NORMAL
	BCC 60$			;LEAVE IT ALONE (PROBABLY A LETTER IN ATTRACT)
				;WE ALSO LEAVE POISON MUSHROOMS ALONE
	LDA MSHTTL
	IFMI
	LDX #POISON+3
	BNE 60$			;BRA
	ENDIF
	CMP #20
	BCS 50$
	CMP #10
	BCS 45$
	CMP #01
	BCC 50$
	CMP #04
	BCS 50$
45$:	TXA			;IT WILL GROW
	CMP #NORMAL+3		;REPLACE IT WITH THE EQUIVALENT GROWTH
	BEQ 60$			;PICTURE, UNLESS COMPLETELY GROWN
	SEC
	SBC #NORMAL-1		;YIELDS 1, 2 OR 3, CARRY SET
	LSR
	ADC #GROWTH		;YIELDS GROWTH+1 OR GROWTH+2
	TAX
	JMP 60$
50$:	TXA			;IT WILL DIE
	SEC
	SBC #NORMAL-DEATHS
	TAX
60$:	TXA
	ORA MSKORA
	CMP #POISON+3+80
	BEQ 70$			;NO POISON MUSHROOM IN PLAYER AREA
	LDY #00
	STA NY,OBST
70$:	RTS
GRCODE:			;0 IS NORMAL CONWAY
			;1 IS ALWAYS GROW
			;2 IS IGNORE
	.BYTE 2,1,1,1,2		;ANOTHER FAIRY RING
	.BYTE 1,0,0,0,1
	.BYTE 1,0,2,0,1
	.BYTE 1,0,0,0,1
	.BYTE 2,1,1,1,2
	.END
