F.PUSH:	.ASCVG	<APPUYER SUR START>
S.PUSH:	.ASCVG	<PULSAR START>
G.PUSH:	.ASCVG	<STARTKNOEPFE DRUECKEN>
	
F.LOW:	.ASCVG	<CARBURANT DIMINUE>
S.LOW:	.ASCVG	<POCO COMBUSTIBLE>
G.LOW:	.ASCVG	<TREIBSTOFF GEHT AUS>
	
F.OUT:	.ASCVG	<PLUS DE CARBURANT>
S.OUT:	.ASCVG	<SIN COMBUSTIBLE>
G.OUT:	.ASCVG	<TREIBSTOFFTANKS LEER>
	
F.LOSS:	.ASCVG	<PERDUES>
S.LOSS:	.ASCVG	<PERDIDAS>
G.LOSS:	.ASCVG	<TEILVERLUST>
	
F.COIN:	.ASCVG	<INTRODUIRE LES PIECES>
S.COIN:	.ASCVG	<INSERTE FICHAS>
G.COIN:	.ASCVG	<GELD AUSWERFEN>
	
F.MONFUEL:.ASCVG	<PAR PIECE>
S.MONFUEL:.ASCVG	<POR FICHA>
G.MONFUEL:.ASCVG	<ZUKAUF PRO MUENZE>

F.DEST:	.ASCVG	<RESERVOIR AUXILIAIRE DE CARBURANT DETRUIT>
S.DEST:	.ASCVG	<TANQUES AUXILIARES DE COMBUSTIBLE DESTRUIDOS>
G.DEST:	.ASCVG	<ZUSATZTREIBSTOFFTANKS ZERSTOERT>
	
F.CONG:	.ASCVG	<FELICITATIONS>
S.CONG:	.ASCVG	<FELICITACIONES>
G.CONG:	.ASCVG	<GRATULATION>
	
F.SATIRE:.ASCVG	<VOUS AVEZ ATTERRI DIFFICILEMENT>
S.SATIRE:.ASCVG	<USTED ALUNIZO VIOLENTAMENTE>
G.SATIRE:.ASCVG	<SIE SIND HART GELANDET>
	
F.GD0:.ASCVG	<SPLENDIDE ATTERRISSAGE>
S.GD0:.ASCVG	<FUE UN GRAN ALUNIZAJE>
G.GD0:.ASCVG	<DIES WAR EINE GROSSARTIGE LANDUNG>
	
F.GD1:.ASCVG	<LE EAGLE A ATTERRI>
S.GD1:.ASCVG	<EL AGUILA HA ALUNIZADO>
G.GD1:.ASCVG	<EAGLE IST GELANDET>
	
F.GD2:.ASCVG	<LE COLUMBIA A ATTERRI>
S.GD2:.ASCVG	<EL COLUMBIA HA ALUNIZADO>
G.GD2:.ASCVG	<COLUMBIA IST GELANDET>
	
F.GD3:.ASCVG	<VOUS AVEZ ATTERRI>
S.GD3:.ASCVG	<USTED HA ALUNIZADO>
G.GD3:.ASCVG	<SIE SIND GELANDET>
	
F.HRD0:.ASCVG	<LE SUPPORT DE SAUVETAGE EST PARTI>
S.HRD0:.ASCVG	<EQUIPO DE SUPERVIVENCIA DESTRUIDO>
G.HRD0:.ASCVG	<LEBENSRETTUNGSSYSTEME SIND AUSGEFALLEN>
	
F.HRD1:.ASCVG	<VOTRE VOYAGE EST SANS RETOUR>
S.HRD1:.ASCVG	<SU VIAJE ES DE IDA SOLAMENTE>
G.HRD1:.ASCVG	<REISE OHNE RUECKKEHR>
	
F.HRD2:.ASCVG	<PERDU SANS ESPOIR>
S.HRD2:.ASCVG	<LAMENTABLEMENTE USTED NO PUEDE VOLVER>
G.HRD2:.ASCVG	<KEIN RUECKSTART ZUR ERDE MOEGLICH>
	
F.HRD3:.ASCVG	<SYSTEME DE COMMUNICATION DETRUIT>
S.HRD3:.ASCVG	<SISTEMA DE COMUNICACION DESTRUIDO>
G.HRD3:.ASCVG	<KOMMUNIKATIONSSYSTEM ZERSTOERT>
	
F.BAD0=	F.HRD3+25.			;DETRUIT
S.BAD0=	S.HRD3+24.			;DESTRUIDO
G.BAD0=	G.HRD3+21.			;ZERSTOERT
	
F.BAD1:	.ASCVG	<VOUS AVEZ CREE UN CRATERE DE DEUX KILOMETRES>
S.BAD1:	.ASCVG	<USTED CREO UN CRATER DE 2 KILOMETROS>
G.BAD1:	.ASCVG	<SIE HABEN EINEN 2 KILOMETER KRATER AUFGERISSEN>
	
F.BAD2:	.ASCVG	<VOUS AVEZ UN CRASH>
S.BAD2:	.ASCVG	<DEMOLER>
G.BAD2:	.ASCVG	<50 000 000 MARK SIND IN DIE LUFT GEJAGT>
	
F.BAD3:	.ASCVG	<IL NEY A PAS DE SURVIVANTS>
S.BAD3:	.ASCVG	<NO HUBO SOBREVIVIENTES>
G.BAD3:	.ASCVG	<KEINE UEBERLEBENDEN>
	
F.HTPNTS:.ASCVG	< POINTS>
S.HTPNTS:.ASCVG	< PUNTOS>
G.HTPNTS:.ASCVG	< PUNKTE>
	
F.SELECT:.ASCVG	<CHOIX DU JEU>
S.SELECT:.ASCVG	<ELEGIR JUEGO>
G.SELECT:.ASCVG	<SPIELWAHL>
	
F.FUELCT:.ASCVG	< UNITES DE CARBURANT >
S.FUELCT:.ASCVG	< UNIDADES DE COMBUSTIBLE >
G.FUELCT:.ASCVG	< TREIBSTOFF >
	.REPT	12.		;EXPANSION ROOM
	.BYTE	0
	.ENDR
