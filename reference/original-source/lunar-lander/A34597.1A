;
MSSVGG:	LABS 76,748
	WAIT 7
	.ASCVG <PUNKTZAHL>
	VCTR -108,-28,0
	.ASCVG <RESTZEIT>
	VCTR -96,-28,0
	.ASCVG <PETROL>
